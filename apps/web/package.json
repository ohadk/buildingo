{
  "name": "@dira/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certs/cloudflare-gateway-ca.pem next dev",
    "build": "next build --webpack",
    "start": "NODE_EXTRA_CA_CERTS=./certs/cloudflare-gateway-ca.pem next start",
