# Copy to .env.local and fill in the values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

FIREBASE_SERVICE_ACCOUNT_PATH=../../firebase-service-account.json

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Client Realtime (anon / publishable) — paste from Supabase → Settings → API
SUPABASE_PUBLISHABLE_KEY=
# or: NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# WAHA (WhatsApp HTTP API) — preferred for tenant WhatsApp messages
WAHA_URL=https://lumina-waha.onrender.com
WAHA_API_KEY=
WAHA_SESSION=buildingo
WAHA_WEBHOOK_SECRET=
# Public HTTPS origin for shareable join links + WAHA webhooks
# (e.g. https://buildingo.com). Do not use localhost here — mobile/API
# may talk to a LAN IP while invites must stay on the public domain.
PUBLIC_WEB_URL=https://buildingo.com

# Public support page (/support) + in-app contact form emails.
CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildingo.com

# Store links used by GET /app (smart download redirect).
# Replace with real listing URLs once published.
APP_STORE_URL=https://apps.apple.com/search?term=Buildingo&entity=software
PLAY_STORE_URL=https://play.google.com/store/search?q=Buildingo&c=apps

# Tenant PII at rest: 32 random bytes, base64-encoded (openssl rand -base64 32).
# When set, phone/email/name are AES-encrypted in Postgres with HMAC hash
# indexes for auth and invite lookups. Run migration 0022, then backfill.
PII_SECRET_KEY=
