# Copy to .env.local and fill in the values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

FIREBASE_SERVICE_ACCOUNT_PATH=../../firebase-service-account.json

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Client Realtime (anon / publishable) — paste from Supabase → Settings → API
SUPABASE_PUBLISHABLE_KEY=
# or: NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Optional: contact-form destination (defaults to FROM if unset).
SENDGRID_TO_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp Business sender (E.164), e.g. +15186760512
TWILIO_WHATSAPP_FROM=
# Twilio Content Template SID for login OTP (variable {{1}} = code).
# Template copy: "{{1}} is your verification code. For your security, do not share this code. This code expires in 15 minutes."
# Alias: TWILIO_PAYMENT_TEMPLATE_SID
TWILIO_WHATSAPP_OTP_TEMPLATE_SID=HX807725b66798d33aed376c31cefdd9b1
TWILIO_PAYMENT_TEMPLATE_SID=HX807725b66798d33aed376c31cefdd9b1

# WAHA (WhatsApp HTTP API) — preferred for tenant WhatsApp messages
WAHA_URL=https://lumina-waha.onrender.com
WAHA_API_KEY=
WAHA_SESSION=buildingo
WAHA_WEBHOOK_SECRET=
# Public HTTPS origin for shareable join links + WAHA webhooks.
# Must be the live App Hosting origin until the custom domain is mapped.
# (Do not use the old Netlify buildingo.com site — /join will not work there.)
PUBLIC_WEB_URL=https://buildingo-api--buildingo-6ff54.us-central1.hosted.app

# Public support page (/support) + in-app contact form emails.
CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildingo.com

# Store links used by GET /app and /open/* fallbacks.
# Replace with real listing URLs once published.
APP_STORE_URL=https://apps.apple.com/search?term=Buildingo&entity=software
PLAY_STORE_URL=https://play.google.com/store/search?q=Buildingo&c=apps

# Android App Links (Digital Asset Links). Comma-separated SHA-256 fingerprints
# of the signing cert(s) — Play App Signing cert + upload/debug as needed.
# Get Play cert: Play Console → App integrity → App signing key certificate.
# Get debug: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android
ANDROID_APP_LINK_SHA256S=

# Tenant PII at rest: 32 random bytes, base64-encoded (openssl rand -base64 32).
# When set, phone/email/name are AES-encrypted in Postgres with HMAC hash
# indexes for auth and invite lookups. Run migration 0022, then backfill.
PII_SECRET_KEY=
