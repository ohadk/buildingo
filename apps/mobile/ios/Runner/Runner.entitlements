<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Firebase Phone Auth silent APNs (TestFlight / App Store). -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links → https://…/open/* opens Buildingo. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:buildingo-api--buildingo-6ff54.us-central1.hosted.app</string>
	</array>
</dict>
</plist>
