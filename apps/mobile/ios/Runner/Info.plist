					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Do NOT declare remote-notification background mode until we deliver
	     user-facing push (Guideline 4.5.4). Firebase Phone Auth can fall back
	     to reCAPTCHA; WhatsApp OTP is the primary sign-in path. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
