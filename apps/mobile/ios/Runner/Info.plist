			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Prevent Firebase Auth reCAPTCHA callbacks (/link?deep_link_id=...) from
	     being treated as Flutter named routes (crashes MaterialApp / breaks SMS). -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tel</string>
		<string>mailto</string>
		<string>https</string>
		<string>http</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Buildingo needs camera access to photograph maintenance faults and scan documents such as Arnona bills.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Buildingo uses your location only while you use the app, to suggest your building’s city and street during setup. We do not track your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Buildingo uses your location to suggest your building’s city and street during setup.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Buildingo needs photo library access so you can attach pictures to fault reports, profile photos, and building documents.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
